    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.21",
    "@types/uuid": "^10.0.0",
    "@vkid/sdk": "^2.6.7",
    "canvas-confetti": "^1.9.4",
    "clsx": "2.1.1",
    "cors": "2.8.6",
    "dotenv": "18.0.4",
    "express": "5.2.1",
