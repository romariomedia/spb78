# ===== Яндекс.Почта (SMTP для OTP администратора) =====
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@yandex.ru
SMTP_PASS=your-app-password-16-chars
SMTP_FROM=your-email@yandex.ru

# ===== Firebase (если развертываете локально) =====
# Скопируйте значения из файла serviceAccountKey.json
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...
# FIREBASE_CLIENT_EMAIL=your-service-account-email

# ===== Vercel / Production =====
# На Vercel переменные устанавливаются через Dashboard
# Settings → Environment Variables

# VK ID server-side verification (used by /api/vk-login)
VK_WEB_APP_ID=54699979
FIREBASE_SERVICE_ACCOUNT_KEY={...}
DEDUPLICATION_SECRET=change-me

# Optional override of the public web push certificate (not a service-account secret).
# VITE_FIREBASE_VAPID_KEY=public-key-from-Firebase-Cloud-Messaging


# ===== YooKassa / SportBuddy78 Business =====
# Real B2B charging remains server-blocked before 2027-01-01 and also requires
# the legal/fiscal/ad-compliance gates below.
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key

# YooKassa receipt data (54-FZ). Configure these from the actual IP tax regime
# and online-cash-register setup; do not guess production values.
YOOKASSA_RECEIPT_MODE=yookassa
YOOKASSA_VAT_CODE=
# Confirm with the accountant/cash-register provider. Examples: full_payment or full_prepayment.
# Do not enable real B2B payments until the required receipt lifecycle is confirmed.
YOOKASSA_PAYMENT_MODE=
# Optional when YooKassa requires an explicit tax system code (1..6).
YOOKASSA_TAX_SYSTEM_CODE=

# Explicit production legal gates. Keep FALSE until the corresponding
# compliance checklist has been completed and documented.
SB_LEGAL_COMPLIANCE_READY=false
SB_AD_MARKING_READY=false


# ===== Future Russian Data Platform (PREPARED, NOT ENABLED) =====
# Keep these defaults until a Russian PostgreSQL/S3 environment is actually
# created, paid for, tested and approved for migration.
SB_DATA_PLATFORM_MODE=legacy
SB_DATA_SHADOW_WRITES_ENABLED=false
SB_DATA_RUSSIAN_PRIMARY_ENABLED=false

# Future PostgreSQL. Leave empty while DATA_PLATFORM_MODE=legacy.
SB_POSTGRES_URL=
# Alternative discrete settings if a provider does not use a single URL:
SB_POSTGRES_HOST=
SB_POSTGRES_PORT=5432
SB_POSTGRES_DB=
SB_POSTGRES_USER=
SB_POSTGRES_PASSWORD=
SB_POSTGRES_SSL=true

# Current media remains Cloudinary. Future provider is russian_s3.
SB_MEDIA_STORAGE_MODE=cloudinary
SB_MEDIA_RUSSIAN_PRIMARY_ENABLED=false

# Future S3-compatible Russian object storage. Leave empty for now.
SB_S3_ENDPOINT=
SB_S3_REGION=
SB_S3_BUCKET=
SB_S3_ACCESS_KEY_ID=
SB_S3_SECRET_ACCESS_KEY=
SB_S3_PUBLIC_BASE_URL=


# ===== Admin-managed Android APK downloads =====
# Persistent directory OUTSIDE immutable web releases. The API creates it on
# first upload. Keep this path on the VPS disk so APK history survives deploys.
SB_APK_STORAGE_ROOT=/opt/sportbuddy-downloads/android
# Expected applicationId. Keep default unless Android package is intentionally migrated.
SB_ANDROID_PACKAGE_NAME=ru.sportbuddy.mobile
# Optional explicit SHA-256 fingerprint(s) of trusted production signing certs.
# Separate multiple fingerprints with comma/semicolon during planned key rotation.
# If empty, the server derives the trust anchor from the bundled, SHA-256-verified v31 APK.
SB_ANDROID_SIGNING_CERT_SHA256=
# Optional override for the trusted reference APK path.
# SB_ANDROID_TRUSTED_APK_PATH=/opt/sportbuddy-current/dist/downloads/sportbuddy78-rustore-v31.apk
